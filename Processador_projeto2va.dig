        <entry>
          <string>Label</string>
          <string>Mux2x1_32bits</string>
        </entry>
        <entry>
          <string>externalInputs</string>
          <string>A:32,B:32,S</string>
        </entry>
        <entry>
          <string>Code</string>
          <string>module Mux2x1_32bits(
    input         S,
    input  [31:0] A,
    input  [31:0] B,
    output [31:0] Y
);

    assign Y = S ? B : A;

endmodule</string>
