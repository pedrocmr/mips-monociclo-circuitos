          <string>Label</string>
          <string>Soma4</string>
        </entry>
        <entry>
          <string>externalInputs</string>
          <string>A:32</string>
        </entry>
        <entry>
          <string>Code</string>
          <string>module Soma4(
    input  [31:0] A,
    output [31:0] Y
);

    assign Y = A + 32&apos;d4;

endmodule</string>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>Y:32</string>
        </entry>
      </elementAttributes>
      <pos x="-1620" y="-940"/>
    </visualElement>
    <visualElement>
      <elementName>External</elementName>
      <elementAttributes>
        <entry>
          <string>applicationType</string>
          <appType>IVERILOG</appType>
        </entry>
        <entry>
          <string>Label</string>
          <string>RegistradorPC</string>
        </entry>
        <entry>
          <string>externalInputs</string>
          <string>A:32,Clk,Rst</string>
        </entry>
        <entry>
          <string>Code</string>
          <string>module RegistradorPC(
    input      [31:0] A,
    input             Clk,
    input             Rst,
    output reg [31:0] Y
);

    always @(posedge Clk or negedge Rst) begin
        if (!Rst)
            Y &lt;= 32&apos;d0;
        else
            Y &lt;= A;
    end

endmodule</string>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>Y:32</string>
        </entry>
      </elementAttributes>
      <pos x="-1760" y="-900"/>
    </visualElement>
    <visualElement>
      <elementName>External</elementName>
      <elementAttributes>
        <entry>
          <string>applicationType</string>
          <appType>IVERILOG</appType>
        </entry>
        <entry>
          <string>Label</string>
          <string>ULA</string>
        </entry>
        <entry>
          <string>externalInputs</string>
          <string>A:32,B:32,Op:5</string>
        </entry>
        <entry>
          <string>Code</string>
          <string>module ULA(
    input  [31:0] A,
    input  [31:0] B,
    input  [4:0]  Op,
    output        zero,
    output reg [31:0] Y
);

    always @(*) begin
        case (Op)
            5&apos;b00000: Y = A + B;
            5&apos;b00001: Y = A - B;
            5&apos;b00010: Y = A &amp; B;
            5&apos;b00011: Y = A | B;
            5&apos;b00100: Y = B &lt;&lt; A[4:0];
            5&apos;b00101: Y = B &gt;&gt; A[4:0];
            5&apos;b00110: Y = A | {16&apos;b0, B[15:0]};
            default:  Y = 32&apos;d0;
        endcase
    end

    assign zero = (Y == 32&apos;d0);

endmodule</string>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>zero,Y:32</string>
        </entry>
      </elementAttributes>
      <pos x="-360" y="-800"/>
    </visualElement>
    <visualElement>
      <elementName>External</elementName>
      <elementAttributes>
        <entry>
          <string>applicationType</string>
          <appType>IVERILOG</appType>
        </entry>
        <entry>
          <string>Label</string>
          <string>ExtensorSinal</string>
        </entry>
        <entry>
          <string>externalInputs</string>
          <string>A:16</string>
        </entry>
        <entry>
          <string>Code</string>
          <string>module ExtensorSinal(
    input  [15:0] A,
    output [31:0] Y
);

    assign Y = {{16{A[15]}}, A};

endmodule</string>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>Y:32</string>
        </entry>
      </elementAttributes>
      <pos x="-1320" y="-580"/>
    </visualElement>
    <visualElement>
      <elementName>External</elementName>
      <elementAttributes>
        <entry>
          <string>applicationType</string>
          <appType>IVERILOG</appType>
        </entry>
        <entry>
          <string>Label</string>
          <string>mux2x1_5bits</string>
        </entry>
        <entry>
          <string>externalInputs</string>
          <string>S,A:5,B:5</string>
        </entry>
        <entry>
          <string>Code</string>
          <string>module mux2x1_5bits(
    input        S,
    input  [4:0] A,
    input  [4:0] B,
    output [4:0] Y
);

    assign Y = S ? B : A;

endmodule</string>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>Y:5</string>
        </entry>
      </elementAttributes>
      <pos x="-1080" y="-780"/>
    </visualElement>
    <visualElement>
      <elementName>External</elementName>
      <elementAttributes>
        <entry>
          <string>applicationType</string>
          <appType>IVERILOG</appType>
        </entry>
        <entry>
          <string>Label</string>
          <string>control</string>
        </entry>
        <entry>
          <string>externalInputs</string>
          <string>instruction:32</string>
        </entry>
        <entry>
          <string>Code</string>
          <string>module control(
    input [31:0] instruction,
    output reg RegDst,
    output reg MemtoReg,
    output reg ALUSrc,
    output reg Branch,
    output reg MemWrite,
    output reg RegWrite,
    output reg [4:0] ALUOp
);

    wire [5:0] opcode;
    wire [5:0] funct;

    assign opcode = instruction[31:26];
    assign funct  = instruction[5:0];

    always @(*) begin
        RegDst   = 1&apos;b0;
        MemtoReg = 1&apos;b0;
        ALUSrc   = 1&apos;b0;
        Branch   = 1&apos;b0;
        MemWrite = 1&apos;b0;
        RegWrite = 1&apos;b0;
        ALUOp    = 5&apos;b00000;

        case (opcode)
            // Instrucoes tipo R
            6&apos;b000000: begin
                RegDst = 1&apos;b1;

                case (funct)
                    6&apos;b100000: begin // add
                        RegWrite = 1&apos;b1;
                        ALUOp = 5&apos;b00000;
                    end

                    6&apos;b100010: begin // sub
                        RegWrite = 1&apos;b1;
                        ALUOp = 5&apos;b00001;
                    end

                    6&apos;b100100: begin // and
                        RegWrite = 1&apos;b1;
                        ALUOp = 5&apos;b00010;
                    end

                    6&apos;b100101: begin // or
                        RegWrite = 1&apos;b1;
                        ALUOp = 5&apos;b00011;
                    end

                    6&apos;b000100: begin // sllv
                        RegWrite = 1&apos;b1;
                        ALUOp = 5&apos;b00100;
                    end

                    6&apos;b000110: begin // srlv
                        RegWrite = 1&apos;b1;
                        ALUOp = 5&apos;b00101;
                    end

                    default: begin
                        RegWrite = 1&apos;b0;
                    end
                endcase
            end

            6&apos;b001000: begin // addi
                ALUSrc   = 1&apos;b1;
                RegWrite = 1&apos;b1;
                ALUOp    = 5&apos;b00000;
            end

            6&apos;b001101: begin // ori
                ALUSrc   = 1&apos;b1;
                RegWrite = 1&apos;b1;
                ALUOp    = 5&apos;b00110;
            end

            6&apos;b100011: begin // lw
                ALUSrc   = 1&apos;b1;
                MemtoReg = 1&apos;b1;
                RegWrite = 1&apos;b1;
                ALUOp    = 5&apos;b00000;
            end

            6&apos;b101011: begin // sw
                ALUSrc   = 1&apos;b1;
                MemWrite = 1&apos;b1;
                ALUOp    = 5&apos;b00000;
            end

            6&apos;b000100: begin // beq
                Branch = 1&apos;b1;
                ALUOp  = 5&apos;b00001;
            end

            default: begin
                // Instrucao nao suportada:
                // mantem os valores padrao, sem escrita.
            end
        endcase
    end

endmodule</string>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>RegDst,MemtoReg,ALUSrc,Branch,MemWrite,RegWrite,ALUOp:5</string>
        </entry>
        <entry>
          <string>Width</string>
          <int>12</int>
        </entry>
      </elementAttributes>
      <pos x="-1460" y="-840"/>
    </visualElement>
    <visualElement>
      <elementName>External</elementName>
      <elementAttributes>
        <entry>
          <string>applicationType</string>
          <appType>IVERILOG</appType>
        </entry>
        <entry>
          <string>Label</string>
          <string>BancoReg</string>
        </entry>
        <entry>
          <string>externalInputs</string>
          <string>RegRd1:5,RegRd2:5,RegWr:5,WrData:32,Write,rst,clk,RbAdd:5</string>
        </entry>
        <entry>
          <string>Code</string>
          <string>module BancoReg(
    input  [4:0]  RegRd1,
    input  [4:0]  RegRd2,
    input  [4:0]  RegWr,
    input  [31:0] WrData,
    input         Write,
    input         rst,
    input         clk,
    input  [4:0]  RbAdd,
    output [31:0] RdData1,
    output [31:0] RdData2,
    output [31:0] Rb
);

    reg [31:0] registradores [0:31];
    integer i;

    always @(posedge clk or negedge rst) begin
        if (!rst) begin
            for (i = 0; i &lt; 32; i = i + 1)
                registradores[i] &lt;= 32&apos;d0;
        end
        else if (Write &amp;&amp; RegWr != 5&apos;d0) begin
            registradores[RegWr] &lt;= WrData;
        end
    end

    assign RdData1 = (RegRd1 == 5&apos;d0)
                   ? 32&apos;d0 : registradores[RegRd1];

    assign RdData2 = (RegRd2 == 5&apos;d0)
                   ? 32&apos;d0 : registradores[RegRd2];

    assign Rb = (RbAdd == 5&apos;d0)
              ? 32&apos;d0 : registradores[RbAdd];

endmodule</string>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>RdData1:32,RdData2:32,Rb:32</string>
        </entry>
        <entry>
          <string>Width</string>
          <int>10</int>
        </entry>
      </elementAttributes>
